++package com.mallner.triplogger.obd
++
++import android.Manifest
++import android.bluetooth.BluetoothAdapter
++import android.bluetooth.BluetoothDevice
++import android.content.BroadcastReceiver
++import android.content.Context
++import android.content.Intent
++import android.content.IntentFilter
++import android.content.pm.PackageManager
++import android.os.Build
++import android.util.Log
++import androidx.core.content.ContextCompat
++import kotlinx.coroutines.CancellableContinuation
++import kotlinx.coroutines.suspendCancellableCoroutine
++import kotlinx.coroutines.withTimeoutOrNull
++import kotlin.coroutines.resume
++
++class ObdScanner(
++    private val context: Context,
++    private val bluetoothAdapter: BluetoothAdapter
++) {
++
++    /**
++     * Scans for a specific Bluetooth device by its name or address.
++     *
++     * This function will start a Bluetooth discovery and return the `BluetoothDevice`
++     * as soon as it finds one matching the provided `targetIdentifier` (which can be a name or MAC address).
++     *
++     * @param targetIdentifier The name or MAC address of the OBD device to find.
++     * @param timeoutMillis The maximum time to scan before giving up.
++     * @return The found `BluetoothDevice`, or `null` if it's not found within the timeout or if permissions are missing.
++     */
++    suspend fun findDevice(targetIdentifier: String, timeoutMillis: Long = 15000L): BluetoothDevice? {
++        // 1. Check for required permissions before scanning.
++        if (!hasRequiredPermissions()) {
++            Log.e("ObdScanner", "Bluetooth permissions (SCAN and CONNECT) are not granted.")
++            return null
++        }
++
++        if (!bluetoothAdapter.isEnabled) {
++            Log.e("ObdScanner", "Bluetooth is not enabled.")
++            return null
++        }
++
++        // Using withTimeoutOrNull to automatically handle cancellation and timeout.
++        return withTimeoutOrNull(timeoutMillis) {
++            // suspendCancellableCoroutine allows us to bridge the callback-based BroadcastReceiver
++            // with coroutines in a safe way.
++            suspendCancellableCoroutine { continuation ->
++                val receiver = createBroadcastReceiver(targetIdentifier, continuation)
++
++                // This block is called when the coroutine is cancelled (e.g., by timeout).
++                continuation.invokeOnCancellation {
++                    Log.d("ObdScanner", "Scan cancelled. Unregistering receiver and stopping discovery.")
++                    stopDiscovery(receiver)
++                }
++
++                Log.d("ObdScanner", "Starting discovery to find '$targetIdentifier'...")
++                context.registerReceiver(receiver, IntentFilter(BluetoothDevice.ACTION_FOUND))
++                bluetoothAdapter.startDiscovery()
++            }
++        }
++    }
++
++    private fun createBroadcastReceiver(
++        targetIdentifier: String,
++        continuation: CancellableContinuation<BluetoothDevice>
++    ) = object : BroadcastReceiver() {
++        override fun onReceive(context: Context, intent: Intent) {
++            if (intent.action == BluetoothDevice.ACTION_FOUND) {
++                val device: BluetoothDevice? = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
++                    intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE, BluetoothDevice::class.java)
++                } else {
++                    @Suppress("DEPRECATION")
++                    intent.getParcelableExtra(BluetoothDevice.EXTRA_DEVICE)
++                }
++
++                // A found device might have a null name.
++                val deviceName = try { device?.name } catch (e: SecurityException) { null }
++                val deviceAddress = device?.address
++
++                Log.v("ObdScanner", "Found device: Name='${deviceName ?: "N/A"}', Address='$deviceAddress'")
++
++                // Check if the found device matches our target.
++                if (device != null && (deviceName == targetIdentifier || deviceAddress == targetIdentifier)) {
++                    Log.i("ObdScanner", "Target device '$targetIdentifier' found!")
++
++                    // Stop discovery immediately to save power.
++                    stopDiscovery(this)
++
++                    // Safely resume the coroutine with the found device.
++                    if (continuation.isActive) {
++                        continuation.resume(device)
++                    }
++                }
++            }
++        }
++    }
++
++    private fun stopDiscovery(receiver: BroadcastReceiver) {
++        try {
++            if (bluetoothAdapter.isDiscovering) {
++                bluetoothAdapter.cancelDiscovery()
++            }
++            context.unregisterReceiver(receiver)
++        } catch (e: Exception) {
++            // Can happen if receiver was already unregistered. It's safe to ignore.
++            Log.w("ObdScanner", "Error unregistering receiver, may have already been unregistered.", e)
++        }
++    }
++
++    private fun hasRequiredPermissions(): Boolean {
++        // Permissions changed in Android 12 (API 31)
++        val permissions = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
++            listOf(Manifest.permission.BLUETOOTH_SCAN, Manifest.permission.BLUETOOTH_CONNECT)
++        } else {
++            listOf(Manifest.permission.BLUETOOTH, Manifest.permission.BLUETOOTH_ADMIN, Manifest.permission.ACCESS_FINE_LOCATION)
++        }
++        return permissions.all {
++            ContextCompat.checkSelfPermission(context, it) == PackageManager.PERMISSION_GRANTED
++        }
++    }
++}
