++package com.mallner.triplogger.obd
++
++import android.bluetooth.BluetoothDevice
++import android.bluetooth.BluetoothSocket
++import android.util.Log
++import com.mallner.triplogger.signals.SignalStore
++import kotlinx.coroutines.*
++import java.io.InputStream
++import java.io.OutputStream
++import java.util.UUID
++
++class ObdManager(
++    private val scope: CoroutineScope,
++    private val signalStore: SignalStore,
++    private val deviceID: String
++) {
++
++    private var socket: BluetoothSocket? = null
++    private var job: Job? = null
++
++    private var isConnected: Boolean = false
++    private val sppUuid: UUID =
++        UUID.fromString("00001101-0000-1000-8000-00805F9B34FB") // Serial Port Profile (SPP)
++
++
++    fun disconnect() {
++        isConnected = false
++    }
++
++    fun start(
++        device: BluetoothDevice,
++        pids: List<ObdPid>
++    ) {
++        stop()
++
++        job = scope.launch(Dispatchers.IO) {
++            try {
++                val (input, output) = if (!isConnected) {
++                    socket = device.createInsecureRfcommSocketToServiceRecord(sppUuid)
++                    socket!!.connect()
++
++                    val inputStream = socket!!.inputStream
++                    val outputStream = socket!!.outputStream
++
++                    initElm(outputStream, inputStream)
++                    Log.d("ObdManager", "ELM327 Initialized and connected.")
++                    isConnected = true
++                    Pair(inputStream, outputStream)
++                } else {
++                    Pair(socket!!.inputStream, socket!!.outputStream)
++                }
++
++                while (isActive) {
++                    for (pid in pids) {
++                        send(output, pid.pid)
++                        Log.d("ObdManager", "Sent: ${pid.pid}")
++                        val response = readResponse(input)
++                        Log.d("ObdManager", "Received response: $response")
++                        pid.parser(response)?.let { value ->
++                            signalStore.update("obd.${pid.pid}", value)
++                        }
++
++                        if (!isActive) { break }
++                        delay(80)
++                    }
++                }
++            } catch (e: Exception) {
++                Log.e("ObdManager", "OBD error", e)
++            }
++        }
++    }
++
++    fun stop() {
++        job?.cancel()
++        job = null
++
++        try {
++            socket?.close()
++        } catch (_: Exception) {
++        } finally {
++            socket = null
++        }
++    }
++
++    private suspend fun initElm(output: OutputStream, input: InputStream) {
++        val commands = listOf("ATZ", "ATE0", "ATL0", "ATS0", "ATH0", "ATSP0")
++        for (cmd in commands) {
++            send(output, cmd)
++            Log.d("ObdManager", "Sent: $cmd")
++
++            val resp = readResponse(input)
++            Log.d("ObdManager", "Received response: $resp")
++
++            delay(150)
++        }
++    }
++
++    private fun send(output: OutputStream, cmd: String) {
++        output.write((cmd + "\r").toByteArray())
++        output.flush()
++    }
++
++    private fun readResponse(input: InputStream): String {
++        val sb = StringBuilder()
++        while (true) {
++            val c = input.read().toChar()
++            if (c == '>') break
++            sb.append(c)
++        }
++        return sb.toString().trim()
++    }
++}
