++package com.mallner.triplogger.obd
++
++data class ObdPid(
++    val pid: String,                 // e.g. "010C"
++    val name: String,                // e.g. "Engine RPM"
++    val unit: String,
++    val parser: (String) -> Any?
++)
++
++object StandardPids {
++
++    val ENGINE_RPM = ObdPid(
++        pid = "010C",
++        name = "Engine RPM",
++        unit = "rpm"
++    ) { response ->
++        val m = Regex("41 0C ([0-9A-F]{2}) ([0-9A-F]{2})").find(response) ?: return@ObdPid null
++        val a = m.groupValues[1].toInt(16)
++        val b = m.groupValues[2].toInt(16)
++        ((a * 256) + b) / 4
++    }
++
++    val VEHICLE_SPEED = ObdPid(
++        pid = "010D",
++        name = "Vehicle Speed",
++        unit = "km/h"
++    ) { response ->
++        val m = Regex("41 0D ([0-9A-F]{2})").find(response) ?: return@ObdPid null
++        m.groupValues[1].toInt(16)
++    }
++
++    val ALL = listOf(
++        ENGINE_RPM,
++        VEHICLE_SPEED
++    )
++}
